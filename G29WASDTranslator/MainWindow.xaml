<Window x:Class="G29WASDTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G29WASDTranslator"
        mc:Ignorable="d"
        Title="G29 to WASD Translator" Height="700" Width="980"
        MinHeight="620" MinWidth="860"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#20252B" CornerRadius="8" Padding="14">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#E05A5A" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText" Text="Searching for Logitech G29..." Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="RunningText" Text="Stopped" DockPanel.Dock="Right" Foreground="#AAB3BD" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F4F6F8" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LIVE INPUT" FontWeight="Bold" Foreground="#59636E" Margin="0,0,0,12"/>
                    <TextBlock Text="Steering" FontWeight="SemiBold"/>
                    <Grid Height="42" Margin="0,6,0,14">
                        <Border Background="#DCE2E8" Height="8" VerticalAlignment="Center" CornerRadius="4"/>
                        <Border Width="2" Height="30" Background="#7A8490" HorizontalAlignment="Center"/>
                        <Border x:Name="SteeringMarker" Width="10" Height="30" Background="#2684FF" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock x:Name="SteeringValue" Text="0%" HorizontalAlignment="Center" Foreground="#59636E"/>
                    <TextBlock Text="Accelerator" FontWeight="SemiBold" Margin="0,14,0,5"/>
                    <ProgressBar x:Name="AcceleratorBar" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="AcceleratorValue" Text="0%" HorizontalAlignment="Right" Foreground="#59636E"/>
                    <TextBlock Text="Brake" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <ProgressBar x:Name="BrakeBar" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="BrakeValue" Text="0%" HorizontalAlignment="Right" Foreground="#59636E"/>
                    <TextBlock Text="WASD OUTPUT" FontWeight="Bold" Foreground="#59636E" Margin="0,22,0,10"/>
                    <UniformGrid Rows="2" Columns="3" Width="230" Height="150">
                        <Border/><Border x:Name="KeyW" Style="{StaticResource KeyStyle}"><TextBlock Text="W" Style="{StaticResource KeyTextStyle}"/></Border><Border/>
                        <Border x:Name="KeyA" Style="{StaticResource KeyStyle}"><TextBlock Text="A" Style="{StaticResource KeyTextStyle}"/></Border>
                        <Border x:Name="KeyS" Style="{StaticResource KeyStyle}"><TextBlock Text="S" Style="{StaticResource KeyTextStyle}"/></Border>
                        <Border x:Name="KeyD" Style="{StaticResource KeyStyle}"><TextBlock Text="D" Style="{StaticResource KeyTextStyle}"/></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#F4F6F8" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="#59636E" Margin="0,0,0,12"/>
                        <TextBlock Text="Axis assignment"/>
                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Steering" Width="80" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SteeringAxisCombo" Grid.Row="0" Grid.Column="1" Margin="4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Accelerator" Width="80" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AcceleratorAxisCombo" Grid.Row="1" Grid.Column="1" Margin="4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Brake" Width="80" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BrakeAxisCombo" Grid.Row="2" Grid.Column="1" Margin="4"/>
                            <Button x:Name="CalibrateButton" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Set steering center" Margin="0,6,0,0" Click="CalibrateButton_Click"/>
                            <Button x:Name="CalibratePedalsButton" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="Calibrate pedal ranges" Margin="0,6,0,0" Click="CalibratePedalsButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="RawAxisValue" Text="Raw axes: waiting for device" FontSize="11" Foreground="#59636E" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Steering sensitivity preset" Margin="0,2,0,5"/>
                        <ComboBox x:Name="SteeringPresetCombo" Margin="0,0,0,8" SelectionChanged="SteeringPresetCombo_SelectionChanged">
                            <ComboBoxItem Content="Gentle - easier steering"/>
                            <ComboBoxItem Content="Balanced - everyday use"/>
                            <ComboBoxItem Content="Precise - smaller steering movements"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Steering deadzone"/>
                                <TextBlock Text="Keeps tiny wheel movements from activating keys" FontSize="10" Foreground="#7A8490"/>
                            </StackPanel>
                            <TextBox x:Name="DeadzoneText" Grid.Column="1" Width="64" Text="5%" TextAlignment="Right" VerticalAlignment="Center" LostFocus="ThresholdText_LostFocus" KeyDown="ThresholdText_KeyDown"/>
                        </Grid>
                        <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Steering activation threshold"/>
                                <TextBlock Text="How far the wheel must turn before A or D" FontSize="10" Foreground="#7A8490"/>
                            </StackPanel>
                            <TextBox x:Name="SteeringThresholdText" Grid.Column="1" Width="64" Text="12%" TextAlignment="Right" VerticalAlignment="Center" LostFocus="ThresholdText_LostFocus" KeyDown="ThresholdText_KeyDown"/>
                        </Grid>
                        <Slider x:Name="SteeringThresholdSlider" Minimum="1" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="InvertSteeringCheck" Content="Invert steering direction" Margin="0,6,0,10"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Accelerator threshold"/>
                                <TextBlock Text="How far W must be pressed" FontSize="10" Foreground="#7A8490"/>
                            </StackPanel>
                            <TextBox x:Name="AcceleratorThresholdText" Grid.Column="1" Width="64" Text="8%" TextAlignment="Right" VerticalAlignment="Center" LostFocus="ThresholdText_LostFocus" KeyDown="ThresholdText_KeyDown"/>
                        </Grid>
                        <Slider x:Name="AcceleratorThresholdSlider" Minimum="0" Maximum="90" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="InvertAcceleratorCheck" Content="Invert accelerator axis" Margin="0,6,0,10"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Brake threshold"/>
                                <TextBlock Text="How far S must be pressed" FontSize="10" Foreground="#7A8490"/>
                            </StackPanel>
                            <TextBox x:Name="BrakeThresholdText" Grid.Column="1" Width="64" Text="8%" TextAlignment="Right" VerticalAlignment="Center" LostFocus="ThresholdText_LostFocus" KeyDown="ThresholdText_KeyDown"/>
                        </Grid>
                        <Slider x:Name="BrakeThresholdSlider" Minimum="0" Maximum="90" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="InvertBrakeCheck" Content="Invert brake axis" Margin="0,6,0,12"/>
                        <Button x:Name="ResetSettingsButton" Content="Reset control thresholds" Height="30" Margin="0,0,0,10" Click="ResetSettingsButton_Click"/>
                        <CheckBox x:Name="StartupCheck" Content="Launch at Windows startup"/>
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to system tray" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2">
            <Button x:Name="StartStopButton" Content="Start Translation" Width="180" Height="42" FontSize="15" FontWeight="Bold" Click="StartStopButton_Click"/>
            <Button x:Name="ExitButton" Content="Exit" Width="100" Height="42" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" Click="ExitButton_Click"/>
            <TextBlock Text="DirectInput polling at 200 Hz" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7A8490"/>
        </DockPanel>
    </Grid>
</Window>
